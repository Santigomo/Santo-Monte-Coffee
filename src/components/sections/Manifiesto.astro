---
/** Manifiesto: la frase de marca sobre papel, con la foto catando frente a la montaña. */
import { Image } from 'astro:assets';
import foto from '../../../assets/fotos/ambiente/catando-frente-a-la-montana-2400.jpg';
import type { Lang } from '@/i18n/ui';
import { useTranslations, path } from '@/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="sm-bg-papel sm-textura" style="--textura:url('/brand/curvas-negro.svg'); --textura-opacidad:.9" data-parallax="80" aria-labelledby="manifiesto-titulo">
  <div class="sm-wrap grid gap-12 py-20 md:py-32 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7" data-reveal>
      <p class="sm-etiqueta mb-8">{t('frase.vio')}</p>
      <h2 id="manifiesto-titulo" class="sm-serif text-step-3">
        {lang === 'es' ? <>Los montes miran.<br />Y solo aprueban lo que es verdad.</> : <>The mountains watch.<br />And they only approve what is true.</>}
      </h2>
      <div class="mt-10 grid max-w-2xl gap-6 text-step-0 sm:grid-cols-2">
        <p>
          {lang === 'es'
            ? 'Santo Monte nace en la montaña del Huila. Trabajamos lotes pequeños, seleccionados a mano, con la variedad, el proceso y la altura escritos en cada bolsa.'
            : 'Santo Monte was born in the mountains of Huila. We work small, hand-sorted lots, with variety, process and altitude written on every bag.'}
        </p>
        <p>
          {lang === 'es'
            ? 'Tostamos para mostrar el origen, no para esconderlo. Si un café no pasa la prueba del monte, no lleva nuestro ojo.'
            : 'We roast to reveal origin, not to hide it. If a coffee doesn’t pass the mountain’s test, it doesn’t carry our eye.'}
        </p>
      </div>
      <a href={path('origen', lang)} class="sm-boton mt-10">{lang === 'es' ? 'Conoce el origen' : 'Meet the origin'} <span class="sm-flecha" aria-hidden="true">→</span></a>
    </div>
    <figure class="lg:col-span-5" data-reveal data-delay="0.15">
      <Image src={foto} alt={lang === 'es' ? 'Una persona prueba café al atardecer frente a la montaña.' : 'Someone tasting coffee at dusk in front of the mountain.'} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 38vw, 92vw" class="aspect-[4/5] w-full object-cover grayscale-[15%]" quality={72} />
      <figcaption class="sm-etiqueta mt-3 flex justify-between"><span>{lang === 'es' ? 'Catando frente a la montaña' : 'Cupping in front of the mountain'}</span><span>01</span></figcaption>
    </figure>
  </div>
</section>
