---
/**
 * Formulario de pedido: presentación + cantidad → WhatsApp con mensaje prellenado.
 * Sin JavaScript el enlace abre WhatsApp con 1 bolsa de la primera presentación.
 */
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { waPedido, type MensajePedido } from '@/lib/whatsapp';

interface Props {
  lang: Lang;
  /** Nombre del producto tal como aparece en el mensaje. */
  producto: string;
  presentaciones: string[];
  mensaje: MensajePedido;
  id: string;
}
const { lang, producto, presentaciones, mensaje, id } = Astro.props;
const t = useTranslations(lang);
const enlace = waPedido({ producto, presentacion: presentaciones[0] ?? '', cantidad: 1 }, mensaje);
---
<form data-pedido data-producto={producto} data-mensaje={JSON.stringify(mensaje)} class="space-y-6" aria-labelledby={`${id}-titulo`}>
  <h2 id={`${id}-titulo`} class="sm-etiqueta">{t('pedido.titulo')}</h2>

  <fieldset>
    <legend class="sm-etiqueta mb-3">{t('pedido.presentacion')}</legend>
    <div class="flex flex-wrap gap-2">
      {presentaciones.map((p, i) => (
        <label class="cursor-pointer">
          <input type="radio" name="presentacion" value={p} checked={i === 0} class="peer sr-only" />
          <span class="sm-display inline-flex min-h-12 min-w-20 items-center justify-center border border-[var(--line)] px-4 text-step-1 transition-colors peer-checked:border-[var(--fg)] peer-checked:bg-[var(--fg)] peer-checked:text-[var(--color-leche)] peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-crema" style="border-width: var(--rule)">{p}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div>
    <label for={`${id}-cantidad`} class="sm-etiqueta mb-3 block">{t('pedido.cantidad')}</label>
    <div class="inline-flex items-stretch border border-[var(--fg)]" style="border-width: var(--rule)">
      <button type="button" class="grid size-12 place-items-center text-step-1 transition-colors hover:bg-[var(--fg)] hover:text-[var(--color-leche)]" data-cantidad-menos aria-label={t('pedido.menos')} aria-controls={`${id}-cantidad`}>−</button>
      <input id={`${id}-cantidad`} name="cantidad" type="number" inputmode="numeric" min="1" max="24" value="1" class="sm-display w-16 border-x border-[var(--fg)] bg-transparent text-center text-step-2 [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" style="border-inline-width: var(--rule)" />
      <button type="button" class="grid size-12 place-items-center text-step-1 transition-colors hover:bg-[var(--fg)] hover:text-[var(--color-leche)]" data-cantidad-mas aria-label={t('pedido.mas')} aria-controls={`${id}-cantidad`}>+</button>
    </div>
  </div>

  <div class="space-y-3">
    <a href={enlace} data-pedido-enlace target="_blank" rel="noopener" class="sm-boton sm-boton--lleno w-full sm:w-auto">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.7-1.2 2.2 2.2 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3Z"/></svg>
      {t('cta.whatsapp')}
    </a>
    <p class="max-w-md text-step--1 opacity-80">{t('pedido.nota')}</p>
  </div>
</form>
