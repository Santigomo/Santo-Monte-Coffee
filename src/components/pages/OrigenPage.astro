---
/** Origen: Finca Anaya, Pitalito, la altura y el camino de la cereza a la bolsa. */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FichaLote from '@/components/brand/FichaLote.astro';
import ComoPedir from '@/components/sections/ComoPedir.astro';
import atardecer from '../../../assets/fotos/editadas/atardecer-graduada.jpg';
import granos from '../../../assets/fotos/editadas/granos-graduada.jpg';
import manos from '../../../assets/fotos/editadas/manos-graduada.jpg';
import site from '@/data/site.json';
import lote from '@/data/lote.json';
import { routes, type Lang } from '@/i18n/ui';
import { useTranslations, path, formatAltura } from '@/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const es = lang === 'es';
const altura = formatAltura(lote.alturaMsnm, lang);

const etapas = es
  ? [
      { n: '01', titulo: 'Selección', texto: 'Solo la cereza roja. Se recoge a mano, se pasa por agua para retirar la que flota y se clasifica el grano por densidad.' },
      { n: '02', titulo: 'Proceso', texto: 'Lavado para una taza limpia y brillante; natural, secado dentro de su cereza, para más cuerpo, dulzor y fruta madura.' },
      { n: '03', titulo: 'Tostión', texto: 'Tostamos para mostrar el origen, no para esconderlo. Más oscuro no es más fuerte: es más tostado.' },
      { n: '04', titulo: 'A mano', texto: 'Cada bolsa se sella y se etiqueta a mano, con productor, variedad, proceso y altura escritos en la etiqueta.' },
    ]
  : [
      { n: '01', titulo: 'Selection', texto: 'Only red cherries. Picked by hand, floated to remove the ones that rise, and sorted by density.' },
      { n: '02', titulo: 'Process', texto: 'Washed for a clean, bright cup; natural, dried inside its cherry, for more body, sweetness and ripe fruit.' },
      { n: '03', titulo: 'Roast', texto: 'We roast to reveal origin, not to hide it. Darker isn’t stronger: it’s just more roasted.' },
      { n: '04', titulo: 'By hand', texto: 'Every bag is sealed and labelled by hand, with producer, variety, process and altitude written on the label.' },
    ];

const lugar = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: lote.finca,
  address: { '@type': 'PostalAddress', addressLocality: lote.municipio, addressRegion: lote.departamento, addressCountry: 'CO' },
  additionalProperty: { '@type': 'PropertyValue', name: 'elevation', value: lote.alturaMsnm, unitCode: 'MTR' },
};
---
<BaseLayout
  lang={lang}
  title={es ? `Origen · ${lote.finca}, ${lote.municipio}, Huila · ${site.nombre}` : `Origin · ${lote.finca}, ${lote.municipio}, Huila · ${site.nombre}`}
  description={es
    ? `El café de Santo Monte viene de ${lote.finca}, en ${lote.municipio}, Huila, a ${altura} m s. n. m. Selección a mano, procesos lavado y natural, y tostión pensada para mostrar el origen.`
    : `Santo Monte coffee comes from ${lote.finca} in ${lote.municipio}, Huila, at ${altura} m a.s.l. Hand sorting, washed and natural processing, and a roast designed to reveal origin.`}
  alternates={routes.origen}
  seccion={`${t('seccion.origen')} · ${lote.finca}`}
  activa="origen"
  jsonLd={[lugar]}
>
  <section class="relative isolate overflow-hidden" aria-labelledby="origen-titulo">
    <Image src={atardecer} alt="" widths={[640, 960, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={70} class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-negro via-negro/55 to-negro/20"></div>
    <div class="sm-wrap flex min-h-[80svh] flex-col justify-end pb-14 pt-32">
      <p class="sm-etiqueta mb-5">{lote.municipio}, {lote.departamento} · {lote.pais}</p>
      <h1 id="origen-titulo" class="sm-display text-step-5">{lote.finca}</h1>
      <p class="sm-serif mt-5 max-w-xl text-step-2 text-crema">{es ? `A ${altura} metros, donde la montaña decide.` : `At ${altura} metres, where the mountain decides.`}</p>
    </div>
  </section>

  <section class="sm-bg-papel sm-textura" style="--textura:url('/brand/curvas-negro.svg')" aria-labelledby="finca-titulo">
    <div class="sm-wrap grid gap-12 py-20 md:py-28 lg:grid-cols-12">
      <div class="lg:col-span-6" data-reveal>
        <h2 id="finca-titulo" class="sm-serif text-step-4">{es ? 'Un mismo monte. Distintas formas de mirarlo.' : 'One mountain. Different ways of seeing it.'}</h2>
        <div class="mt-8 max-w-xl space-y-4">
          <p>{es
            ? `El Lote ${Number(lote.numero)} reúne cinco cafés de ${lote.finca}, del productor ${lote.productor}, en ${lote.municipio}, al sur del Huila. Cinco variedades y dos procesos que muestran lo que la misma montaña puede dar.`
            : `Lot ${Number(lote.numero)} brings together five coffees from ${lote.finca}, by producer ${lote.productor}, in ${lote.municipio}, southern Huila. Five varieties and two processes showing what the same mountain can give.`}</p>
          <p>{es
            ? 'Antes de comprar, lee la bolsa: finca, productor, variedad, proceso y altura. Si no lo dice, pregunta.'
            : 'Before you buy, read the bag: farm, producer, variety, process and altitude. If it doesn’t say, ask.'}</p>
        </div>
      </div>
      <div class="lg:col-span-5 lg:col-start-8" data-reveal data-delay="0.1">
        <FichaLote lang={lang} extra={[{ label: es ? 'Finca' : 'Farm', valor: lote.finca }, { label: es ? 'Lote' : 'Lot', valor: lote.numero }]} />
      </div>
    </div>
  </section>

  <section class="sm-bg-negro" aria-labelledby="camino-titulo">
    <div class="sm-wrap py-20 md:py-28">
      <h2 id="camino-titulo" class="sm-display mb-12 text-step-4" data-reveal>{es ? 'De la cereza a la bolsa' : 'From cherry to bag'}</h2>
      <ol class="grid border-t border-[var(--line)] sm:grid-cols-2 lg:grid-cols-4" style="border-top-width: var(--rule)" data-reveal-group>
        {etapas.map((e) => (
          <li class="border-b border-[var(--line)] py-8 sm:pr-8" style="border-bottom-width: var(--rule)">
            <span class="sm-contorno block text-step-4">{e.n}</span>
            <h3 class="sm-serif mt-4 text-step-2">{e.titulo}</h3>
            <p class="mt-3 text-step--1 text-leche/85">{e.texto}</p>
          </li>
        ))}
      </ol>
      <div class="mt-14 grid gap-4 md:grid-cols-12">
        <figure class="md:col-span-7" data-reveal>
          <Image src={granos} alt={es ? 'Granos de café tostado en primer plano.' : 'Close-up of roasted coffee beans.'} widths={[480, 800, 1200]} sizes="(min-width: 768px) 56vw, 92vw" quality={70} class="aspect-[6/5] w-full object-cover" />
        </figure>
        <figure class="md:col-span-5" data-reveal data-delay="0.1">
          <Image src={manos} alt={es ? 'Manos sosteniendo granos de café.' : 'Hands holding coffee beans.'} widths={[400, 640, 900]} sizes="(min-width: 768px) 40vw, 92vw" quality={70} class="aspect-[3/4] w-full object-cover" />
        </figure>
      </div>
      <a href={path('cafes', lang)} class="sm-boton sm-boton--lleno mt-12">{t('cta.verCafes')} <span class="sm-flecha" aria-hidden="true">→</span></a>
    </div>
  </section>

  <ComoPedir lang={lang} />
</BaseLayout>
